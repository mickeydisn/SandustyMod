{
    "tasks": {
        "build:main": "deno bundle -o build/main.js src/main.ts",
        "build:modinfo": "cp src/modinfo.json build/modinfo.json",
        "build:toGame": "mkdir -p \"/Users/mickey/Library/Application Support/sandustry/mods/md-my-hown-mod\" && cp -r build/. \"/Users/mickey/Library/Application Support/sandustry/mods/md-my-hown-mod/\"",
        "build": "deno task build:sprites && deno task build:main && deno task build:modinfo && deno task build:assets && deno task build:toGame",
        "check": "deno check src/main.ts",
        "build:sprites": "deno run -A tools/gen-sprite-library.ts && deno run -A tools/gen-icons.ts",
        "build:assets": "mkdir -p build/assets && cp -r assets/. build/assets/ 2>/dev/null || true"
    },
    "compilerOptions": {
        "lib": [
            "deno.window",
            "dom"
        ],
        "strict": true
    },
    "fmt": {
        "exclude": [
            "src/generated",
            "src/sprite-editor"
        ]
    },
    "lint": {
        // Vendored third-party package, copied whole from sprite-editor-package/
        // so it can be refreshed by replacing the folder. Its `any` and `window`
        // use is inherent — a canvas overlay talking to a dynamically-typed host
        // API — and linting it says nothing about this mod's own code.
        "exclude": [
            "src/sprite-editor"
        ]
    },
    "exclude": [
        "main.js",
        "worker.js",
        "build"
    ]
}
