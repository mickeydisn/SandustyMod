  "processes": [
    {
      "id": "artefact-generator-tick",
      "name": "Artefact Generator — eat",
      "scope": "processing",
      "steps": [
        {
          "key": "bufferRead",
          "options": {
            "path": "materialIndex"
          },
          "as": "rolled"
        },
        {
          "key": "structureData",
          "options": {
            "key": "matPref"
          },
          "as": "pref"
        },
        {
          "key": "compare",
          "options": {
            "left": "{{pref}}",
            "op": "gt",
            "right": "0"
          },
          "as": "hasPref"
        },
        {
          "key": "compare",
          "options": {
            "left": "{{pref}}",
            "op": "eq",
            "right": "2"
          },
          "as": "wantsGold"
        },
        {
          "key": "compare",
          "options": {
            "left": "{{pref}}",
            "op": "eq",
            "right": "3"
          },
          "as": "wantsCopper"
        },
        {
          "key": "compare",
          "options": {
            "left": "{{pref}}",
            "op": "eq",
            "right": "4"
          },
          "as": "wantsSand"
        },
        {
          "key": "if",
          "options": {
            "var": "hasPref"
          },
          "then": [
            {
              "key": "if",
              "options": {
                "var": "wantsGold"
              },
              "then": [
                {
                  "key": "math",
                  "options": {
                    "left": "0",
                    "op": "add",
                    "right": "0"
                  },
                  "as": "idx"
                }
              ]
            },
            {
              "key": "if",
              "options": {
                "var": "wantsCopper"
              },
              "then": [
                {
                  "key": "math",
                  "options": {
                    "left": "1",
                    "op": "add",
                    "right": "0"
                  },
                  "as": "idx"
                }
              ]
            },
            {
              "key": "if",
              "options": {
                "var": "wantsSand"
              },
              "then": [
                {
                  "key": "math",
                  "options": {
                    "left": "2",
                    "op": "add",
                    "right": "0"
                  },
                  "as": "idx"
                }
              ]
            }
          ],
          "else": [
            {
              "key": "math",
              "options": {
                "left": "{{rolled}}",
                "op": "add",
                "right": "0"
              },
              "as": "idx"
            }
          ]
        },
        {
          "key": "compare",
          "options": {
            "left": "{{idx}}",
            "op": "eq",
            "right": "0"
          },
          "as": "isGold"
        },
        {
          "key": "compare",
          "options": {
            "left": "{{idx}}",
            "op": "eq",
            "right": "1"
          },
          "as": "isCopper"
        },
        {
          "key": "compare",
          "options": {
            "left": "{{idx}}",
            "op": "eq",
            "right": "2"
          },
          "as": "isSand"
        },
        {
          "key": "bufferWrite",
          "options": {
            "path": "links-gold",
            "value": "0"
          }
        },
        {
          "key": "bufferWrite",
          "options": {
            "path": "links-copper",
            "value": "0"
          }
        },
        {
          "key": "bufferWrite",
          "options": {
            "path": "links-sand",
            "value": "0"
          }
        },
        {
          "key": "if",
          "options": {
            "var": "isGold"
          },
          "then": [
            {
              "key": "bufferWrite",
              "options": {
                "path": "links-gold",
                "value": "1"
              }
            },
            {
              "key": "logicCount",
              "options": {
                "element": "gold",
                "dx": "2",
                "dy": "2",
                "size": "3"
              },
              "as": "eaten"
            },
            {
              "key": "removeElement",
              "options": {
                "element": "gold",
                "dx": "2",
                "dy": "2",
                "size": "3"
              }
            },
            {
              "key": "math",
              "options": {
                "left": "{{eaten}}",
                "op": "div",
                "right": "1"
              },
              "as": "charge"
            },
            {
              "key": "bufferIncrement",
              "options": {
                "path": "progress",
                "delta": "{{charge}}"
              }
            },
            {
              "key": "setStructureData",
              "options": {
                "key": "material",
                "value": "Gold",
                "propagateToWorkers": "true"
              }
            },
            {
              "key": "setStructureData",
              "options": {
                "key": "mult",
                "numberValue": "1",
                "propagateToWorkers": "true"
              }
            }
          ]
        },
        {
          "key": "if",
          "options": {
            "var": "isCopper"
          },
          "then": [
            {
              "key": "bufferWrite",
              "options": {
                "path": "links-copper",
                "value": "1"
              }
            },
            {
              "key": "logicCount",
              "options": {
                "element": "copper",
                "dx": "2",
                "dy": "2",
                "size": "3"
              },
              "as": "eaten"
            },
            {
              "key": "removeElement",
              "options": {
                "element": "copper",
                "dx": "2",
                "dy": "2",
                "size": "3"
              }
            },
            {
              "key": "math",
              "options": {
                "left": "{{eaten}}",
                "op": "div",
                "right": "0.5"
              },
              "as": "charge"
            },
            {
              "key": "bufferIncrement",
              "options": {
                "path": "progress",
                "delta": "{{charge}}"
              }
            },
            {
              "key": "setStructureData",
              "options": {
                "key": "material",
                "value": "Copper",
                "propagateToWorkers": "true"
              }
            },
            {
              "key": "setStructureData",
              "options": {
                "key": "mult",
                "numberValue": "0.5",
                "propagateToWorkers": "true"
              }
            }
          ]
        },
        {
          "key": "if",
          "options": {
            "var": "isSand"
          },
          "then": [
            {
              "key": "bufferWrite",
              "options": {
                "path": "links-sand",
                "value": "1"
              }
            },
            {
              "key": "logicCount",
              "options": {
                "element": "sand",
                "dx": "2",
                "dy": "2",
                "size": "3"
              },
              "as": "eaten"
            },
            {
              "key": "removeElement",
              "options": {
                "element": "sand",
                "dx": "2",
                "dy": "2",
                "size": "3"
              }
            },
            {
              "key": "math",
              "options": {
                "left": "{{eaten}}",
                "op": "div",
                "right": "5"
              },
              "as": "charge"
            },
            {
              "key": "bufferIncrement",
              "options": {
                "path": "progress",
                "delta": "{{charge}}"
              }
            },
            {
              "key": "setStructureData",
              "options": {
