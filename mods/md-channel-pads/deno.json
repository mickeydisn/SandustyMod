{
    "tasks": {
        "build:main": "deno bundle -o build/main.js src/main.ts",
        "build:modinfo": "cp src/modinfo.json build/modinfo.json",
        "build:assets": "mkdir -p build/assets && cp assets/*.png build/assets/",
        "build:i18n": "mkdir -p build/i18n && cp i18n/*.json build/i18n/",
        "build:toGame": "cp -r build/. /Users/mickey/Library/Application\\ Support/sandustry/mods/md-channel-pads",

        "build": "deno task build:main && deno task build:modinfo && deno task build:assets && deno task build:i18n && deno task build:toGame",
        "check": "deno check src/main.ts"
    },
    "compilerOptions": {
        "lib": ["deno.window", "dom"],
        "strict": true
    },
    "exclude": ["main.js", "worker.js"]
}
